# Credentials for the local scripts (npm run setup / migrate / deploy).
# Copy to .env. Not needed for `npm test`.
#
# Create the token at https://dash.cloudflare.com/profile/api-tokens with
# only these permissions (least privilege):
#   Account > Workers Scripts: Edit, D1: Edit, Workers AI: Read
# The same two values are the GitHub secrets used by the deploy workflow.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

