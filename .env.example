# =============================================================================
# LLMOps Platform — Environment configuration
#   cp .env.example .env      (Windows PowerShell: copy .env.example .env)
#
# Without any key the stack still starts: the dashboards show 30 days of
# synthetic demo data. Add at least one key to send real traffic.
#
# IN GITHUB ACTIONS these values are injected automatically:
#   🔒 Secrets: ANTHROPIC_API_KEY, OPENAI_API_KEY
# =============================================================================

# --- Provider keys (only the gateway reads them; clients never see them) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Demo agent ---
# "anthropic" | "openai" (empty = Anthropic if its key is set, else OpenAI)
AGENT_PROVIDER=
ANTHROPIC_MODEL=claude-opus-5-5
OPENAI_MODEL=gpt-4o-mini
# Claude effort: low | medium | high | xhigh | max
AGENT_EFFORT=medium
AGENT_MAX_STEPS=8
AGENT_LOOP_REPEAT_LIMIT=3

# --- Guardrails ---
# The gateway refuses (HTTP 402) further calls of a run past this spend.
MAX_RUN_COST_USD=0.50
# Project used when a client sends no X-Project header and no /p/<project>/ URL
DEFAULT_PROJECT=default

# --- Demo data ---
SEED_DEMO_DATA=true
SEED_DAYS=30

# --- PostgreSQL ---
POSTGRES_DB=llmops
POSTGRES_USER=llmops
POSTGRES_PASSWORD=llmops

# --- Grafana admin login (dashboards are also viewable anonymously) ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# --- Host ports published by docker compose ---
GATEWAY_HOST_PORT=8090
GRAFANA_HOST_PORT=3000
PROMETHEUS_HOST_PORT=9090
POSTGRES_HOST_PORT=5433
