      {
        "name": "project",
        "label": "Project",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "llmops-postgres"
        },
        "query": "SELECT DISTINCT project FROM llm_requests ORDER BY 1",
        "definition": "SELECT DISTINCT project FROM llm_requests ORDER BY 1",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "current": {
          "text": [
            "All"
