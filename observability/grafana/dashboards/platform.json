        "type": "dashboard"
      },
      {
        "name": "Releases",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "llmops-postgres"
        },
        "enable": true,
        "iconColor": "#A352CC",
        "target": {
          "refId": "Anno",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "llmops-postgres"
          },
          "rawSql": "SELECT ts AS time, 'Release ' || version || COALESCE(' — ' || notes, '') AS text, service AS tags FROM deployments WHERE $__timeFilter(ts) AND ('$source' = 'all' OR synthetic = ('$source' = 'demo'))",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      }
    ]
