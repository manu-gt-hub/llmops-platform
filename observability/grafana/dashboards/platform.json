        "name": "source",
        "label": "Data",
        "type": "custom",
        "query": "all,real,demo",
        "current": {
          "text": "all",
          "value": "all"
        },
        "options": [
          {
            "text": "all",
            "value": "all",
            "selected": true
          },
          {
            "text": "real",
            "value": "real",
            "selected": false
          },
          {
            "text": "demo",
            "value": "demo",
            "selected": false
          }
        ],
        "description": "real = traffic through the gateway; demo = synthetic seed data"
