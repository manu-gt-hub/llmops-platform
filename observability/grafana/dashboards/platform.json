          "rawSql": "SELECT $__timeGroupAlias(ts, '1d', 0), status_code::text AS metric, COUNT(*) AS value FROM llm_requests WHERE status_code >= 400 AND $__timeFilter(ts) AND ('$source' = 'all' OR synthetic = ('$source' = 'demo')) AND project IN ($project) GROUP BY 1, 2 ORDER BY 1",
