          "rawSql": "SELECT $__timeGroupAlias(ts, '1d', 0), project AS metric, SUM(cost_usd) AS value FROM llm_requests WHERE $__timeFilter(ts) AND ('$source' = 'all' OR synthetic = ('$source' = 'demo')) AND project IN ($project) GROUP BY 1, 2 ORDER BY 1",
