    {
      "type": "bargauge",
      "title": "Budget used this month",
      "description": "Month-to-date spend / monthly budget (config/budgets.yaml)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "llmops-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "llmops-postgres"
          },
          "rawSql": "SELECT r.project AS \"project\", SUM(r.cost_usd) / MAX(COALESCE(b.monthly_usd, d.monthly_usd)) AS \"used\" FROM llm_requests r LEFT JOIN budgets b ON b.project = r.project CROSS JOIN (SELECT monthly_usd FROM budgets WHERE project = 'default') d WHERE r.ts >= date_trunc('month', now()) AND ('$source' = 'all' OR r.synthetic = ('$source' = 'demo')) AND r.project IN ($project) GROUP BY 1 ORDER BY 2 DESC",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1.2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
