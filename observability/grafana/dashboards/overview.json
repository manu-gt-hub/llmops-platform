          "rawSql": "SELECT COALESCE(SUM(cost_usd), 0) FROM llm_requests WHERE ts >= date_trunc('month', now()) AND ('$source' = 'all' OR synthetic = ('$source' = 'demo')) AND project IN ($project)",
