            "uid": "llmops-postgres"
          },
          "rawSql": "SELECT AVG((status = 'success')::int) FROM agent_runs WHERE started_at >= now() - interval '7 days' AND status <> 'running' AND ('$source' = 'all' OR synthetic = ('$source' = 'demo'))",
