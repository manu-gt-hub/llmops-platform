    {
      "type": "stat",
      "title": "Last release",
      "description": "Latest gateway release that started",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "llmops-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "llmops-postgres"
          },
          "rawSql": "SELECT version, ts FROM deployments WHERE ('$source' = 'all' OR synthetic = ('$source' = 'demo')) ORDER BY ts DESC LIMIT 1",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": null,
          "thresholds": {
