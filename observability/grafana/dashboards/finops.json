            "type": "grafana-postgresql-datasource",
            "uid": "llmops-postgres"
          },
          "rawSql": "SELECT $__timeGroupAlias(ts, '1d', 0), project AS metric, SUM(cache_read_tokens)::float / NULLIF(SUM(input_tokens + cache_read_tokens + cache_write_tokens), 0) AS value FROM llm_requests WHERE $__timeFilter(ts) AND ('$source' = 'all' OR synthetic = ('$source' = 'demo')) AND project IN ($project) GROUP BY 1, 2 ORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code"
