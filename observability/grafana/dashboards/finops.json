          "rawSql": "SELECT $__timeGroupAlias(started_at, '1d', 0), SUM(cost_usd) FILTER (WHERE status = 'success') / NULLIF(COUNT(*) FILTER (WHERE status = 'success'), 0) AS \"cost per success\", SUM(cost_usd) / NULLIF(COUNT(*), 0) AS \"cost per run\" FROM agent_runs WHERE $__timeFilter(started_at) AND ('$source' = 'all' OR synthetic = ('$source' = 'demo')) AND project IN ($project) GROUP BY 1 ORDER BY 1",
