{
  "uid": "llmops-finops",
  "title": "LLMOps — FinOps",
  "description": "Token usage and spend by date, model and project; budgets, cache savings and unit cost",
  "tags": [
    "llmops"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "source",
        "label": "Data",
        "type": "custom",
        "query": "all,real,demo",
        "current": {
          "text": "all",
          "value": "all"
        },
        "options": [
          {
            "text": "all",
            "value": "all",
            "selected": true
          },
          {
            "text": "real",
            "value": "real",
            "selected": false
          },
          {
            "text": "demo",
            "value": "demo",
            "selected": false
          }
        ],
        "description": "real = traffic through the gateway; demo = synthetic seed data"
      },
      {
        "name": "project",
        "label": "Project",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "llmops-postgres"
        },
        "query": "SELECT DISTINCT project FROM llm_requests ORDER BY 1",
        "definition": "SELECT DISTINCT project FROM llm_requests ORDER BY 1",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "name": "Releases",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "llmops-postgres"
        },
        "enable": true,
        "iconColor": "#A352CC",
        "target": {
          "refId": "Anno",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "llmops-postgres"
          },
          "rawSql": "SELECT ts AS time, 'Release ' || version || COALESCE(' — ' || notes, '') AS text, service AS tags FROM deployments WHERE $__timeFilter(ts) AND ('$source' = 'all' OR synthetic = ('$source' = 'demo'))",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      }
    ]
  },
