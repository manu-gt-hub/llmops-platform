    {
      "type": "stat",
      "title": "Month-end forecast",
      "description": "Linear projection: month-to-date spend / days elapsed × days in month",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "llmops-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "llmops-postgres"
          },
          "rawSql": "SELECT COALESCE(SUM(cost_usd), 0) / GREATEST(extract(epoch FROM now() - date_trunc('month', now())) / 86400, 1) * extract(day FROM date_trunc('month', now()) + interval '1 month - 1 day') FROM llm_requests WHERE ts >= date_trunc('month', now()) AND ('$source' = 'all' OR synthetic = ('$source' = 'demo')) AND project IN ($project)",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "wideLayout": true
      },
      "id": 2,
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      }
    },
