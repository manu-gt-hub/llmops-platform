    {
      "type": "table",
      "title": "Spend by project and model",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "llmops-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "llmops-postgres"
          },
          "rawSql": "SELECT project, model, COUNT(*) AS requests, SUM(input_tokens) AS \"input\", SUM(output_tokens) AS \"output\", SUM(cache_read_tokens) AS \"cache read\", SUM(cost_usd) AS cost, SUM(cost_usd) / NULLIF(COUNT(*), 0) AS \"cost / request\" FROM llm_requests WHERE $__timeFilter(ts) AND ('$source' = 'all' OR synthetic = ('$source' = 'demo')) AND project IN ($project) GROUP BY 1, 2 ORDER BY cost DESC",
          "format": "table",
          "rawQuery": true,
