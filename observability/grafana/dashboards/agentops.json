    {
      "type": "timeseries",
      "title": "Eval pass rate and steps per run",
      "description": "Quality (nightly eval suite) against effort (steps). Releases are annotated.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "llmops-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "llmops-postgres"
          },
          "rawSql": "SELECT $__timeGroupAlias(ts, '1d', 0), AVG(passed::int) AS \"eval pass rate\" FROM eval_results WHERE $__timeFilter(ts) AND ('$source' = 'all' OR synthetic = ('$source' = 'demo')) GROUP BY 1 ORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "llmops-postgres"
          },
          "rawSql": "SELECT $__timeGroupAlias(started_at, '1d', 0), AVG(steps) AS \"avg steps\" FROM agent_runs WHERE $__timeFilter(started_at) AND status <> 'running' AND ('$source' = 'all' OR synthetic = ('$source' = 'demo')) AND project IN ($project) GROUP BY 1 ORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": null,
          "custom": {
