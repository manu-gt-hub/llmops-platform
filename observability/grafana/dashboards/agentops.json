            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "p95 ms"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
