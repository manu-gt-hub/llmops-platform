    {
      "type": "table",
      "title": "Tools",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "llmops-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "llmops-postgres"
          },
          "rawSql": "SELECT name AS tool, COUNT(*) AS calls, COUNT(*) FILTER (WHERE NOT ok) AS errors, AVG((NOT ok)::int) AS \"error rate\", percentile_cont(0.95) WITHIN GROUP (ORDER BY latency_ms) AS \"p95 ms\" FROM agent_steps WHERE kind = 'tool' AND $__timeFilter(ts) AND ('$source' = 'all' OR synthetic = ('$source' = 'demo')) GROUP BY 1 ORDER BY calls DESC",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
