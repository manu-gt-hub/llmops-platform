    {
      "type": "timeseries",
      "title": "Runs per day by outcome",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "llmops-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "llmops-postgres"
          },
          "rawSql": "SELECT $__timeGroupAlias(started_at, '1d', 0), COUNT(*) FILTER (WHERE status = 'success') AS \"success\", COUNT(*) FILTER (WHERE status = 'failed') AS \"failed\", COUNT(*) FILTER (WHERE status = 'killed') AS \"killed\", COUNT(*) FILTER (WHERE status = 'error') AS \"error\" FROM agent_runs WHERE $__timeFilter(started_at) AND status <> 'running' AND ('$source' = 'all' OR synthetic = ('$source' = 'demo')) AND project IN ($project) GROUP BY 1 ORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": null,
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 2,
            "fillOpacity": 80,
            "barAlignment": 0,
            "showPoints": "never",
            "spanNulls": true,
            "pointSize": 4,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "axisSoftMin": 0
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "success"
            },
            "properties": [
              {
                "id": "color",
                "value": {
