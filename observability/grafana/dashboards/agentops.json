    {
      "type": "table",
      "title": "Recent runs",
      "description": "Real runs carry a trace id: click it to open the trace",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "llmops-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "llmops-postgres"
          },
          "rawSql": "SELECT started_at AS started, run_id, task_id AS task, model, status, stop_reason, steps, tool_calls AS tools, tool_errors, loop_detected AS loop, total_tokens AS tokens, cost_usd AS cost, trace_id AS trace FROM agent_runs WHERE $__timeFilter(started_at) AND status <> 'running' AND ('$source' = 'all' OR synthetic = ('$source' = 'demo')) AND project IN ($project) ORDER BY started_at DESC LIMIT 50",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "cost"
            },
